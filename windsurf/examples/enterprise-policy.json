{
  "$schema": "https://ai-secure-configs.example/schemas/windsurf/enterprise-policy.json",
  "_comment": "Windsurf / Devin Desktop enterprise policy reference (Moderate-aligned). Deploy MDM keys via registry (Windows), MDM profile (macOS), or /etc/windsurf/policies/policy.json (Linux). Configure DevinCliTeamSettings in the Admin Portal.",

  "AllowedExtensions": [
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",
    "ms-python.python",
    "golang.go",
    "eamodio.gitlens",
    "ms-vscode.vscode-typescript-next"
  ],

  "UpdateMode": "manual",

  "WorkspaceTrustEnabled": true,

  "TelemetryLevel": "off",

  "ProxySettings": {
    "http_proxy": "http://proxy.corp.example.com:8080",
    "https_proxy": "https://proxy.corp.example.com:8443",
    "no_proxy": "localhost,127.0.0.1,.corp.example.com"
  },

  "MdmPolicies": {
    "AllowedExtensions": "{\"ms-python\": true, \"golang\": true, \"github\": true, \"esbenp\": true, \"dbaeumer\": true, \"eamodio\": true, \"ms-vscode\": true}",
    "UpdateMode": "manual",
    "EnableTelemetry": false,
    "EnableFeedback": false
  },

  "SecuritySettings": {
    "disableUntrustedWorkspaces": true,
    "enforceProxyStrictSSL": true,
    "blockExternalExtensions": true,
    "disableDeploys": true,
    "disableConversationSharing": true,
    "enableAttributionFiltering": true
  },

  "AgentSettings": {
    "autoExecutionLevel": "confirm_destructive",
    "requireHumanConfirmation": true,
    "cascadeMaxSteps": 50,
    "enableDevinLocalAgent": false
  },

  "McpGovernance": {
    "mode": "whitelist",
    "approvedServers": [
      "github-mcp-server",
      "postgres-mcp-server"
    ],
    "blockUnapproved": true,
    "mcpRegistryUrls": [
      "https://registry.modelcontextprotocol.io"
    ],
    "mcpRegistryEnforcement": true
  },

  "DevinCliTeamSettings": {
    "enableWebSearch": false,
    "mcpServersEnabled": true,
    "mcpRegistryEnforcement": true,
    "mcpRegistryUrls": [
      "https://registry.modelcontextprotocol.io"
    ],
    "showInstallDevinCli": false,
    "sandboxEnforcement": "optional",
    "sandboxAllowedDomains": [
      "github.com",
      "**.npmjs.org",
      "**.pypi.org",
      "**.crates.io"
    ],
    "sandboxDeniedDomains": [
      "*.ngrok.io",
      "*.localtunnel.me"
    ],
    "sandboxExcluded": {
      "deny": [
        "Exec(**)"
      ],
      "allow": [
        "Exec(gh *)"
      ],
      "ask": [
        "Exec(git push *)"
      ]
    },
    "terminalPermissions": {
      "deny": [
        "Write(.env*)",
        "Write(**/secrets/**)",
        "Exec(sudo)",
        "Exec(rm -rf *)"
      ],
      "ask": [
        "exec"
      ],
      "allow": [
        "Read(~/approved-repos/**)"
      ]
    }
  }
}
