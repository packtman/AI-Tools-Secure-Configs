{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "BASELINE enterprise policy. Essential security only: blocks the most dangerous patterns while maximizing developer autonomy. Suitable for startups, individual developers, and low-risk internal tools. Model selection is unset on purpose; pin availableModels and enforceAvailableModels when you need an org allowlist. Example per-tool MCP policy: approved GitHub reads run without confirmation; GitHub mutations prompt; destructive and high-risk MCP calls denied.",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "LS",
      "Diff",
      "Write",
      "Edit",
      "MultiEdit",
      "WebFetch",
      "mcp__github__search_repositories",
      "mcp__github__get_file_contents"
    ],
    "ask": [
      "Bash",
      "mcp__github__create_issue",
      "mcp__github__create_pull_request"
    ],
    "deny": [
      "mcp__github__delete_file",
      "mcp__github__push_files",
      "mcp__filesystem__*",
      "mcp__shell__*",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(eval *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(nc -l *)",
      "Bash(python* -m http.server*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(//etc/shadow)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.bashrc)",
      "Write(~/.zshrc)",
      "Write(./.env)",
      "Write(./.env.*)"
    ],
    "defaultMode": "default"
  },
  "allowManagedPermissionRulesOnly": false,
  "disableAutoMode": "allow",
  "allowManagedHooksOnly": false,
  "allowManagedMcpServersOnly": false,
  "allowManagedPluginsOnly": false,
  "disableRemoteControl": false,
  "disableDeepLinkRegistration": "allow",
  "disableWorkflows": false,
  "disableAgentView": false,
  "disableArtifact": false,
  "awaySummaryEnabled": true,
  "channelsEnabled": true,
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.38",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_MCP_ALLOWLIST_ENV": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  }
}
