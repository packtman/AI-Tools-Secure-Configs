{
  "schema_version": 1,
  "tools": [
    {
      "id": "claude-code",
      "display_name": "Claude Code",
      "repo_paths": [
        "claude-code/",
        "rollout-guide/configs/claude-code/"
      ],
      "tier_files": {
        "strict": [
          "claude-code/examples/managed-settings-strict.json"
        ],
        "moderate": [
          "claude-code/examples/managed-settings-moderate.json",
          "rollout-guide/configs/claude-code/managed-settings-moderate.json"
        ],
        "baseline": [
          "claude-code/examples/managed-settings-baseline.json"
        ]
      },
      "sources": [
        {
          "name": "Managed settings documentation",
          "kind": "docs",
          "url": "https://docs.anthropic.com/en/docs/claude-code/settings",
          "watch_for": [
            "managed settings",
            "permissions",
            "disableBypassPermissionsMode",
            "sandbox",
            "MCP"
          ]
        },
        {
          "name": "Hooks documentation",
          "kind": "docs",
          "url": "https://docs.anthropic.com/en/docs/claude-code/hooks",
          "watch_for": [
            "PreToolUse",
            "PostToolUse",
            "ConfigChange",
            "audit",
            "permissions"
          ]
        },
        {
          "name": "Dynamic workflows documentation",
          "kind": "docs",
          "url": "https://docs.anthropic.com/en/docs/claude-code/workflows",
          "watch_for": [
            "dynamic workflows",
            "disableWorkflows",
            "CLAUDE_CODE_DISABLE_WORKFLOWS",
            "ultracode",
            "managed settings"
          ]
        }
      ]
    },
