{
  "_comment": "BASELINE Gemini CLI config. Full tool access with sandbox, open MCP, approval bypass disabled, and admin policy denies for destructive shell commands. Use for startups and individual developers.",

  "general": {
    "enableAutoUpdate": true
  },

  "privacy": {
    "usageStatisticsEnabled": false
  },

  "tools": {
    "sandbox": "docker"
  },

  "mcp": {},

  "mcpServers": {},

  "security": {
    "disableYoloMode": true,
    "disableAlwaysAllow": false,
    "environmentVariableRedaction": {
      "enabled": true,
      "allowed": []
    },
    "folderTrust": {
      "enabled": true
    }
  },

  "hooksConfig": {
    "enabled": true
  },

  "telemetry": {
    "enabled": false,
    "logPrompts": false
  },

  "model": {
    "name": "gemini-2.5-pro",
    "maxSessionTurns": -1
  },

  "context": {
    "fileFiltering": {
      "respectGitIgnore": true,
      "respectGeminiIgnore": true
    }
  }
}
