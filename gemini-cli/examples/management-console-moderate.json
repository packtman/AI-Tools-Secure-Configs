{
  "_comment": "MODERATE Management Console targets for Gemini CLI enterprise. Apply in the Google Management Console (https://goo.gle/manage-gemini-cli). Do NOT copy the admin object into local settings files. Replace placeholder MCP URLs with org-approved remote endpoints. Prefer secrets manager / OAuth over embedding client secrets.",
  "console": {
    "strictMode": "enabled",
    "extensions": "disabled",
    "mcpEnabled": "enabled",
    "mcpServersAllowlist": {
      "corp-data-api": {
        "url": "https://mcp.example.corp/data-api",
        "type": "http",
        "trust": false,
        "includeTools": ["search", "query", "get-document"],
        "excludeTools": ["admin", "delete", "export-all"]
      }
    },
    "requiredMcpServers": {
      "corp-compliance-audit": {
        "url": "https://mcp.example.corp/compliance",
        "type": "http",
        "trust": false,
        "description": "Mandatory remote compliance MCP injected for every enterprise user",
        "includeTools": ["check-policy", "record-attestation"]
      }
    },
    "unmanagedCapabilities": "disabled"
  },
  "runtimeAdminEquivalent": {
    "admin": {
      "secureModeEnabled": true,
      "extensions": {
        "enabled": false
      },
      "mcp": {
        "enabled": true,
        "config": {
          "corp-data-api": {
            "url": "https://mcp.example.corp/data-api",
            "type": "http",
            "trust": false,
            "includeTools": ["search", "query", "get-document"],
            "excludeTools": ["admin", "delete", "export-all"]
          }
        },
        "requiredConfig": {
          "corp-compliance-audit": {
            "url": "https://mcp.example.corp/compliance",
            "type": "http",
            "trust": false,
            "description": "Mandatory remote compliance MCP injected for every enterprise user",
            "includeTools": ["check-policy", "record-attestation"]
          }
        }
      },
      "skills": {
        "enabled": false
      }
    }
  }
}
