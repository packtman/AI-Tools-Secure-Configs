{
  "$schema": "https://ai-secure-configs.example/schemas/github-copilot/org-policy.json",
  "_comment": "MODERATE GitHub Copilot organization policy. Core features enabled, agents restricted, sensible content exclusion. Use for standard enterprise teams.",

  "organization": "acme-corp",
  "copilot_plan": "enterprise",

  "seat_management": {
    "assignment": "selected_teams",
    "auto_assign_new_members": false,
    "allowed_teams": [
      "engineering",
      "devops",
      "security"
    ]
  },

  "feature_policies": {
    "copilot_in_ide": "enabled",
    "copilot_chat_in_ide": "enabled",
    "copilot_chat_on_github": "enabled",
    "copilot_in_mobile": "let_organizations_decide",
    "copilot_cli": "disabled",
    "copilot_windows_terminal": "disabled",
    "copilot_code_review": "enabled",
    "copilot_vision": "let_organizations_decide",
    "editor_inline_chat": "enabled",
    "model_selection": "disabled",
    "user_feedback_collection": "disabled"
  },

  "agent_policies": {
    "copilot_cloud_agent": {
      "enforcement": "select_organizations",
      "allowed_organizations": ["engineering"]
    },
    "copilot_code_review_agent": "enabled",
    "custom_agents": "let_organizations_decide",
    "third_party_agents": "disabled"
  },

  "mcp_policies": {
    "mcp_server_availability": "enabled",
    "mcp_registry_url": "https://mcp-registry.internal.acme.com",
    "strict_registry_enforcement": false
  },

  "code_review": {
    "org_level_runner": "github-hosted",
    "lock_runner_setting": false
  },

  "content_exclusions": {
    "global_patterns": [
      "**/.env",
      "**/.env.*",
      "**/secrets/**",
      "**/*.pem",
      "**/*.key",
      "**/credentials*",
      "**/terraform.tfstate",
      "**/terraform.tfvars"
    ],
    "excluded_repositories": [
      "acme-corp/payroll-service",
      "acme-corp/security-configs",
      "acme-corp/key-management"
    ]
  },

  "network_routing": {
    "allow_enterprise_traffic": true,
    "allow_business_traffic": true,
    "block_individual_traffic": true,
    "firewall_allowlist": [
      "*.enterprise.githubcopilot.com",
      "*.business.githubcopilot.com"
    ],
    "firewall_blocklist": [
      "*.individual.githubcopilot.com"
    ]
  }
}
