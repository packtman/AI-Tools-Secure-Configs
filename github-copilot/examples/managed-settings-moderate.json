{
  "_comment": "MODERATE GitHub Copilot enterprise managed settings. Deploy as copilot/managed-settings.json in the source organization's .github-private repository, via MDM string keys, or as a device file. Pair with org-policy-moderate.json. Replace YOUR-ORG placeholders before deploy. No secrets belong in this file.",

  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },

  "enabledPlugins": {},

  "extraKnownMarketplaces": {
    "org-plugins": {
      "source": {
        "source": "github",
        "repo": "YOUR-ORG/YOUR-PLUGIN-MARKETPLACE"
      }
    }
  },

  "strictKnownMarketplaces": [
    {
      "source": "github",
      "repo": "YOUR-ORG/YOUR-PLUGIN-MARKETPLACE"
    }
  ],

  "allowedMcpServers": [
    {
      "serverUrl": "https://api.githubcopilot.com/*"
    }
  ],

  "deniedMcpServers": [
    {
      "serverCommand": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/"
      ]
    }
  ],

  "sandbox": {
    "enabled": true,
    "allowBypass": false,
    "sandboxMcpServers": true,
    "sandboxLspServers": true
  },

  "remoteControl": {
    "mode": "requireSSO",
    "githubDotComOrganizations": [
      "YOUR-ORG"
    ]
  }
}
