{
  "general": {
    "defaultApprovalMode": "auto_edit",
    "debugKeystrokeLogging": false,
    "devtools": false
  },
  "tools": {
    "enableRemoteCodeSearch": true,
    "sandbox": true
  },
  "security": {
    "disableYoloMode": true,
    "disableAlwaysAllow": false,
    "enablePermanentToolApproval": false,
    "autoAddToPolicyByDefault": false,
    "blockGitExtensions": true,
    "folderTrust": {
      "enabled": true
    },
    "enableConseca": false,
    "environmentVariableRedaction": {
      "enabled": true,
      "allowed": [],
      "blocked": [
        "ANTHROPIC_API_KEY",
        "AWS_SECRET_ACCESS_KEY",
        "GITHUB_TOKEN",
        "OPENAI_API_KEY"
      ]
    }
  },
  "context": {
    "fileFiltering": {
      "respectGitIgnore": true,
      "respectGeminiIgnore": true
    }
  },
  "telemetry": {
    "enabled": false,
    "logPrompts": false
  },
  "hooksConfig": {
    "enabled": true
  },
  "skills": {
    "enabled": true
  }
}
