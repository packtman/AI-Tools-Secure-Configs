// Claude Code Managed Settings: MODERATE (Enterprise) Tier
// Deploy to the OS-specific managed settings path (see ROLLOUT-PLAN.md Section 4.1).
// Strip comments before deploying as managed-settings.json, or deploy as-is if your
// tooling supports JSONC. See managed-settings-moderate.comments.md for the deployable
// rationale reference.
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "LS",
      "Diff"
    ],
    "ask": [
      "Write",
      "Edit",
      "MultiEdit",
      "Bash",
      "WebFetch",
      "mcp__*"
    ],
    "deny": [
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(python* -c *)",
      "Bash(python* -m http.server*)",
      "Bash(node -e *)",
      "Bash(nohup *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/credentials*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(//etc/shadow)",
      "Read(//etc/passwd)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Write(~/.config/gcloud/**)",
      "Write(~/.azure/**)",
      "Write(~/.kube/**)",
      "Write(~/.docker/**)",
      "Write(~/.gnupg/**)",
      "Write(~/.bashrc)",
      "Write(~/.zshrc)",
      "Write(~/.profile)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)"
    ],
    "disableBypassPermissionsMode": "disable"
  },

  // WHAT: When true, ignore user and project permission rules.
  //   // WHY: Moderate allows teams to add project-specific rules while managed deny still wins.
  //   // BREAKS IF true: Project allow/ask/deny rules stop applying.
  "allowManagedPermissionRulesOnly": false,

  // WHAT: Controls auto mode, which auto-approves tools with background checks.
  //   // WHY: Auto mode is still a research preview and can approve risky actions.
  //   // BREAKS IF allow: Tools may run without interactive approval.
  "disableAutoMode": "disable",

  // WHAT: When true, only managed hooks run.
  //   // WHY: Moderate lets project hooks aid local quality gates.
  //   // BREAKS IF true: Project PreToolUse/PostToolUse hooks stop running.
  "allowManagedHooksOnly": false,

  // WHAT: When true, only managed MCP allowlists connect.
  //   // WHY: Moderate keeps project MCP usable with approval prompts.
  //   // BREAKS IF true: Project .mcp.json servers will not connect.
  "allowManagedMcpServersOnly": false,

  // WHAT: Blocks remote control of Claude Code sessions.
  //   // WHY: Prevents external prompt or command injection into a local session.
  //   // BREAKS IF false: Remote controllers can drive the agent.
  "disableRemoteControl": true,

  // WHAT: Controls deep-link handler registration.
  //   // WHY: Disable reduces unexpected session starts from untrusted links.
  //   // BREAKS IF allow: OS handlers may register for Claude Code deep links.
  "disableDeepLinkRegistration": "disable",

  // WHAT: Disables dynamic workflows and bundled workflow commands.
  //   // WHY: Long-running multi-agent workflows need a monitored pilot first.
  //   // BREAKS IF true: workflow commands and ultracode are unavailable.
  "disableWorkflows": true,

  // WHAT: Turns off background agents and agent view.
  //   // WHY: Background agents expand unsupervised shell, MCP, and network activity.
  //   // BREAKS IF true: claude agents, --bg, and /background are unavailable.
  "disableAgentView": true,

  // WHAT: Disables publishing session output as claude.ai Artifacts.
  //   // WHY: Keeps source and session data out of an extra shareable web surface.
  //   // BREAKS IF true: Developers cannot publish Artifact pages from Claude Code.
  "disableArtifact": true,

  // WHAT: Shows a one-line session recap after the user returns.
  //   // WHY: Recaps can expose sensitive work on shared screens.
  //   // BREAKS IF false: No automatic away-summary line appears.
  "awaySummaryEnabled": false,

  // WHAT: Forces login through Claude.ai or Console.
  //   // WHY: Keeps identity inside the managed org path.
  //   // BREAKS IF wrong: Users may be unable to authenticate.
  "forceLoginMethod": "claudeai",

  // WHAT: Restricts login to one organization UUID.
  //   // WHY: Blocks personal accounts that bypass managed settings.
  //   // BREAKS IF wrong UUID: All users are locked out.
  "forceLoginOrgUUID": "REPLACE_WITH_YOUR_ORG_UUID",

  // WHAT: Restricts auto-updates to a channel.
  //   // WHY: Stable avoids preview behavior changes mid-rollout.
  "autoUpdatesChannel": "stable",

  // WHAT: Hard startup floor for Claude Code.
  //   // WHY: Older clients ignore newer managed controls.
  //   // BREAKS IF above fleet version: Claude Code exits until clients update.
  "requiredMinimumVersion": "2.1.212",

  // WHAT: OS-level filesystem and network isolation for Bash commands.
  // WHY: Defense-in-depth even if permission rules are bypassed by prompt injection.
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "//etc/shadow",
        "//etc/sudoers"
      ],
      "denyWrite": [
        "~/",
        "//etc/",
        "//var/"
      ],
      "allowWrite": [
        ".",
        "/tmp"
      ]
    }
  },

  // WHAT: Environment variables applied to every Claude Code session.
  // WHY: Enforces telemetry off, no auto-memory, foreground-only tasks, no away recap,
  //      and no IDE extension auto-install.
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  }
}
