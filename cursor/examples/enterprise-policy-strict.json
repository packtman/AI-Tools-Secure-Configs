{
  "_doc": "Cursor Enterprise dashboard policy reference for STRICT tier. Apply in the team dashboard and MDM. This file is documentation for admins, not a client-side config drop-in.",

  "_precedence_note": "Team dashboard and MDM override ~/.cursor/permissions.json, sandbox.json, settings.json, and project rules. Users cannot weaken these controls.",

  "identity": {
    "sso_enforced": true,
    "scim_enabled": true,
    "allowed_team_ids_mdm": ["REPLACE_WITH_TEAM_ID"],
    "disable_byok": true,
    "restrict_cli_agents": true,
    "restrict_cloud_agents": true
  },

  "privacy": {
    "privacy_mode_enforced": true,
    "repository_blocklist": ["REPLACE_WITH_SENSITIVE_REPO_URL_OR_PATTERN"],
    "protected_git_scopes": ["REPLACE_WITH_GIT_ORG_OR_NAMESPACE"]
  },

  "run_mode": {
    "default_mode": "allowlist",
    "disable_run_everything": true,
    "allowed_modes": ["allowlist", "auto-review"],
    "sandbox_enforced": true,
    "browser_protection": true,
    "file_deletion_protection": true,
    "external_file_protection": true,
    "cursor_directory_protection": true
  },

  "mcp": {
    "allowlist_enabled": true,
    "approved_servers": [],
    "default_network_mode": "deny_all",
    "distribute_via_team_marketplace_only": true
  },

  "marketplace": {
    "community_plugin_import": false,
    "admin_edits_only": true
  },

  "models": {
    "restrict_to_approved_models": true,
    "require_admin_approval_for_non_zdr_models": true
  },

  "extensions": {
    "install_cooldown_hours": 72,
    "signature_verification": true,
    "allowed_extensions_mdm": {
      "REPLACE_WITH_PUBLISHER_OR_EXTENSION_ID": true
    }
  },

  "cloud_agents": {
    "computer_use": "disabled",
    "team_follow_ups": "disabled",
    "network_access": "allowlist_only",
    "secrets_public_repos": false
  },

  "monitoring": {
    "audit_logs_to_siem": true,
    "hooks_fail_closed": true
  }
}
