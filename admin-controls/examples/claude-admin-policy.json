{
  "_meta": {
    "tool": "Claude (Desktop & Web)",
    "description": "Claude Team/Enterprise admin console policy reference",
    "reference": "claude.ai → Admin Settings → Claude Code → Managed settings",
    "notes": "Server-managed settings are configured in the admin console and delivered to clients at auth time. This template documents the recommended Enterprise configuration for change control purposes.",
    "last_updated": "2026-06-07"
  },
  "organization": {
    "plan": "enterprise",
    "name": "Acme Corp"
  },
  "identity": {
    "sso": {
      "enabled": true,
      "enforced": true,
      "provider": "okta",
      "protocol": "saml_2.0"
    },
    "scim": {
      "enabled": true,
      "auto_deprovision": true
    },
    "domain_verification": {
      "verified_domains": ["acme.com", "acme.io"],
      "domain_capture": true,
      "restrict_external_invites": true
    }
  },
  "managed_settings": {
    "_delivery": "server-managed via admin console (highest precedence)",
    "permissions": {
      "allow": [],
      "deny": [
        "Bash(rm -rf *)",
        "Bash(curl * | bash)",
        "Bash(wget * | sh)",
        "Bash(sudo *)",
        "Read(~/.ssh/*)",
        "Read(~/.aws/*)",
        "Read(**/.env)"
      ],
      "disableBypassPermissionsMode": "disable",
      "disableAutoMode": "disable"
    },
    "allowManagedPermissionRulesOnly": true,
    "forceRemoteSettingsRefresh": true,
    "channelsEnabled": false,
    "sandbox": {
      "enabled": true,
      "failIfUnavailable": true,
      "allowUnsandboxedCommands": false,
      "allowManagedReadPathsOnly": true,
      "allowManagedDomainsOnly": true,
      "network": {
        "allowedDomains": [
          "github.com",
          "*.github.com",
          "npmjs.org",
          "*.npmjs.org",
          "pypi.org",
          "*.pypi.org"
        ]
      }
    },
    "allowManagedHooksOnly": true,
    "allowedHttpHookUrls": [
      "https://hooks.internal.acme.com/*"
    ],
    "strictKnownMarketplaces": true,
    "blockedMarketplaces": [],
    "allowPluginOnlyCustomization": false,
    "allowedMcpServers": [
      {
        "name": "github",
        "url": "https://mcp.github.com"
      },
      {
        "name": "internal-docs",
        "url": "https://mcp.internal.acme.com/docs"
      }
    ],
    "deniedMcpServers": [],
    "allowManagedMcpServersOnly": true
  },
  "desktop_policy": {
    "_delivery": "MDM (plist/registry) or admin console",
    "isLocalDevMcpEnabled": false,
    "isDesktopExtensionEnabled": false,
    "isDesktopExtensionDirectoryEnabled": false,
    "isClaudeCodeForDesktopEnabled": true,
    "secureVmFeaturesEnabled": false,
    "disableAutoUpdates": false,
    "autoUpdaterEnforcementHours": 24,
    "forceLoginOrgUUID": "org_acme_uuid_here"
  },
  "spend_controls": {
    "organization_monthly_budget_usd": 10000,
    "per_user_monthly_cap_usd": 500,
    "extra_usage_enabled": true,
    "extra_usage_max_per_user_usd": 200
  },
  "data_governance": {
    "training_on_data": false,
    "data_residency": "us",
    "retention_policy": "enterprise_default"
  },
  "monitoring": {
    "audit_logs": true,
    "usage_analytics": true,
    "compliance_api": {
      "enabled": true,
      "automated_flagging": true,
      "selective_deletion": true
    },
    "siem_export": {
      "enabled": true,
      "destination": "splunk"
    }
  }
}
