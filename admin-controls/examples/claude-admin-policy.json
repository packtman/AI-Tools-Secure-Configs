{
  "_meta": {
    "tool": "Claude (Desktop & Web)",
    "description": "Claude Team/Enterprise admin console policy reference",
    "reference": "claude.ai → Admin Settings → Claude Code → Managed settings",
    "last_updated": "2026-08-11",
    "notes": "Server-managed settings are configured in the admin console and delivered to clients at auth time. Inference hooks are Claude Enterprise console settings under Data and privacy (not MDM plist keys). This template documents the recommended Enterprise configuration for change control purposes."
  },
  "organization": {
    "plan": "enterprise",
    "name": "Acme Corp"
  },
  "identity": {
    "sso": {
      "enabled": true,
      "enforced": true,
      "provider": "okta",
      "protocol": "saml_2.0"
    },
    "scim": {
      "enabled": true,
      "auto_deprovision": true
    },
    "domain_verification": {
      "verified_domains": ["acme.com", "acme.io"],
      "domain_capture": true,
      "restrict_external_invites": true
    }
  },
  "managed_settings": {
    "_delivery": "server-managed via admin console (highest precedence)",
    "permissions": {
      "allow": [],
      "deny": [
        "Bash(rm -rf *)",
        "Bash(curl * | bash)",
        "Bash(wget * | sh)",
        "Bash(sudo *)",
        "Read(~/.ssh/*)",
        "Read(~/.aws/*)",
        "Read(**/.env)"
      ],
      "disableBypassPermissionsMode": "disable",
      "disableAutoMode": "disable"
    },
    "allowManagedPermissionRulesOnly": true,
    "allowManagedMcpServersOnly": true,
    "allowManagedPluginsOnly": true,
    "channelsEnabled": false,
    "forceRemoteSettingsRefresh": true,
    "claudeMd": "Follow security guidelines. Never commit secrets. Use approved package registries only.",
    "sandbox": {
      "network": {
        "allowedDomains": [
          "*.github.com",
          "*.npmjs.org",
          "*.pypi.org",
          "registry.terraform.io",
          "*.internal.acme.com"
        ]
      }
    },
    "allowedMcpServers": [
      {
        "name": "github",
        "url": "https://mcp.github.com"
      },
      {
        "name": "internal-docs",
        "url": "https://mcp.internal.acme.com/docs"
      }
    ],
    "deniedMcpServers": []
  },
  "desktop_policy": {
    "_delivery": "MDM (plist/registry) or admin console",
    "isLocalDevMcpEnabled": false,
    "isDesktopExtensionEnabled": false,
    "isDesktopExtensionDirectoryEnabled": false,
    "isClaudeCodeForDesktopEnabled": true,
    "secureVmFeaturesEnabled": false,
    "disableAutoUpdates": false,
    "autoUpdaterEnforcementHours": 24
  },
  "capabilities": {
    "_delivery": "claude.ai → Admin Settings → Capabilities",
    "code_execution_and_file_creation": true,
    "allow_network_egress": false,
    "artifacts": true,
    "remote_control": false,
    "channels": false
  },
  "data_governance": {
    "training_on_data": false,
    "data_residency": "us",
    "retention_policy": "enterprise_default",
    "zero_data_retention": true,
    "inference_hooks": {
      "_delivery": "claude.ai → Organization settings → Data and privacy → Inference hooks",
      "_permission": "organization:manage",
      "organization_allowed": true,
      "enforce_verdicts": true,
      "mode": "enforce",
      "failure_handling": "block",
      "endpoint_url": "https://ai-security.example.com/claude/inference-hooks",
      "prompt_verdict_timeout_ms": 3000,
      "rollout_percent": 100,
      "role_exclusions": [],
      "custom_blocked_prompt_message": "Blocked by organizational AI security policy. Open a security exception ticket before retrying.",
      "_secret_note": "Webhook signing secret is revealed once at save. Store in secrets manager only. Never commit."
    }
  },
  "monitoring": {
    "audit_logs": true,
    "usage_analytics": true,
    "contribution_metrics": true,
    "compliance_api": true,
    "inference_hooks_activity_feed": true,
    "siem_export": {
      "enabled": true,
      "destination": "splunk"
    }
  }
}
