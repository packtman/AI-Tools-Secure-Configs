{
  "$schema": "https://ai-secure-configs.example/schemas/claude-api/org-policy.json",
  "_comment": "MODERATE Claude API organization policy. Balanced access control with reasonable rate limits. Use for standard enterprise development teams.",

  "organization": {
    "name": "acme-corp",
    "sso_enforced": true,
    "scim_enabled": true,
    "max_org_admins": 3,
    "compliance_api_enabled": true,
    "activity_log_retention_days": 180
  },

  "default_workspace_policy": {
    "max_members_per_workspace": 25,
    "default_member_role": "workspace_user",
    "api_key_max_age_days": 90,
    "require_key_rotation": true
  },

  "rate_limits": {
    "requests_per_minute": 500,
    "input_tokens_per_minute": 200000,
    "output_tokens_per_minute": 100000
  },

  "spend_controls": {
    "monthly_budget_usd": 10000,
    "alert_thresholds_percent": [50, 75, 90],
    "hard_cap_enabled": true,
    "notification_emails": ["finops@acme.com"]
  },

  "allowed_models": ["claude-sonnet-5", "claude-haiku-4-5", "claude-opus-5"],

  "mcp_tunnels": {
    "_comment": "Keep tunnels off by default. Enable per workspace only after CA certificates are installed and manage_tunnels is limited to admins.",
    "enabled": false,
    "require_ca_certificates": true,
    "admin_scope_required": "workspace:manage_tunnels",
    "beta_header": "mcp-tunnels-2026-06-22",
    "prefer_api_surface": "/v1/tunnels"
  },

  "enterprise_user_management": {
    "custom_roles_enabled": true,
    "prefer_managed_role": true,
    "disallow_connector_always_allow": true,
    "beta_header": "ce-user-management-2026-07-13",
    "audit_scope": "read:org_audit"
  },

  "data_controls": {
    "zero_data_retention": true,
    "disable_training_on_data": true
  }
}
