{
  "$schema": "https://ai-secure-configs.example/schemas/claude-api/org-policy.json",
  "_comment": "BASELINE Claude API organization policy. Essential security with minimal friction. Suitable for startups and individual developers.",

  "organization": {
    "name": "my-org",
    "sso_enforced": false,
    "scim_enabled": false,
    "max_org_admins": 5
  },

  "default_workspace_policy": {
    "default_member_role": "workspace_developer",
    "api_key_max_age_days": 180,
    "require_key_rotation": false
  },

  "rate_limits": {
    "requests_per_minute": 1000,
    "input_tokens_per_minute": 400000,
    "output_tokens_per_minute": 200000
  },

  "spend_controls": {
    "monthly_budget_usd": 50000,
    "alert_thresholds_percent": [75, 90],
    "hard_cap_enabled": false,
    "notification_emails": ["billing@my-org.com"]
  },

  "allowed_models": ["claude-sonnet-5", "claude-haiku-4-5", "claude-opus-5"],

  "mcp_tunnels": {
    "_comment": "Baseline allows tunnel experiments but still requires CA certificates before MCP traffic is accepted.",
    "enabled": true,
    "require_ca_certificates": true,
    "admin_scope_required": "workspace:manage_tunnels",
    "beta_header": "mcp-tunnels-2026-06-22",
    "deprecated_admin_beta_header": "mcp-tunnels-2026-05-19",
    "prefer_api_surface": "/v1/tunnels"
  },

  "fast_mode": {
    "enabled": true,
    "beta_header": "fast-mode-2026-02-01"
  },

  "rate_limit_groups": {
    "prefer_model_group_caps": false
  },

  "enterprise_user_management": {
    "custom_roles_enabled": false,
    "prefer_managed_role": false,
    "disallow_connector_always_allow": false,
    "beta_header": "ce-user-management-2026-07-13",
    "audit_scope": "read:org_audit"
  },

  "data_controls": {
    "zero_data_retention": false,
    "disable_training_on_data": true
  }
}
