{
  "$schema": "https://ai-secure-configs.example/schemas/claude-api/org-policy.json",
  "_comment": "STRICT Claude API organization policy. Maximum access control, tight rate limits, and aggressive spend caps. Use for regulated industries with compliance requirements.",

  "organization": {
    "name": "acme-corp",
    "sso_enforced": true,
    "scim_enabled": true,
    "max_org_admins": 2,
    "compliance_api_enabled": true,
    "activity_log_retention_days": 365
  },

  "default_workspace_policy": {
    "max_members_per_workspace": 10,
    "default_member_role": "workspace_user",
    "api_key_max_age_days": 30,
    "require_key_rotation": true
  },

  "rate_limits": {
    "requests_per_minute": 100,
    "input_tokens_per_minute": 50000,
    "output_tokens_per_minute": 25000
  },

  "spend_controls": {
    "monthly_budget_usd": 2000,
    "alert_thresholds_percent": [25, 50, 75, 90],
    "hard_cap_enabled": true,
    "notification_emails": ["security@acme.com", "finops@acme.com"]
  },

  "allowed_models": ["claude-sonnet-5", "claude-haiku-4-5"],

  "mcp_tunnels": {
    "_comment": "MCP tunnels (research preview) allocate Anthropic hostnames that route MCP traffic. Disable in Strict until CA pinning, scope review, and SIEM alerts are ready.",
    "enabled": false,
    "require_ca_certificates": true,
    "admin_scope_required": "workspace:manage_tunnels",
    "beta_header": "mcp-tunnels-2026-06-22",
    "prefer_api_surface": "/v1/tunnels"
  },

  "enterprise_user_management": {
    "_comment": "Claude Enterprise Admin API user management. Prefer managed + custom roles over Owner for delegated access. Group/custom-role calls need the beta header.",
    "custom_roles_enabled": true,
    "prefer_managed_role": true,
    "disallow_connector_always_allow": true,
    "beta_header": "ce-user-management-2026-07-13",
    "audit_scope": "read:org_audit"
  },

  "data_controls": {
    "zero_data_retention": true,
    "disable_training_on_data": true
  }
}
