{
  "$schema": "https://ai-secure-configs.example/schemas/claude-api/rate-limits-api-policy.json",
  "_comment": "STRICT workspace rate limits and model governance. Fast mode off, tight caps, minimal roles.",

  "rate_limits_api": {
    "enabled": true,
    "poll_interval_minutes": 15,
    "alert_on_workspace_override": true
  },

  "workspace_defaults": {
    "requests_per_minute": 100,
    "input_tokens_per_minute": 50000,
    "output_tokens_per_minute": 25000
  },

  "model_groups": {
    "standard": [
      "claude-haiku-4-20250414"
    ],
    "elevated": []
  },

  "fast_mode": {
    "enabled": false,
    "beta_header": "fast-mode-2026-02-01",
    "require_finops_approval": true,
    "allowed_workspaces": []
  },

  "invite_roles": {
    "default": "workspace_user",
    "allowed_roles": [
      "user",
      "billing"
    ],
    "block_admin_via_api": true
  },

  "managed_agents": {
    "memory_enabled": false,
    "beta_header": "managed-agents-2026-04-01"
  }
}
