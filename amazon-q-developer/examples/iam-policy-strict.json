{
  "Version": "2012-10-17",
  "_comment": "STRICT - Chat and code suggestions only. Denies PassRequest, agents, plugins, customizations, and admin. Region-locked. MFA required. Use for regulated environments.",
  "Statement": [
    {
      "Sid": "AllowQReadOnlyChat",
      "Effect": "Allow",
      "Action": [
        "q:StartConversation",
        "q:SendMessage",
        "q:GetConversation",
        "q:ListConversations",
        "q:UpdateConversation",
        "q:DeleteConversation",
        "codewhisperer:GenerateRecommendations",
        "codewhisperer:ListCodeAnalysisFindings"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ["us-east-1"]
        },
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    },
    {
      "Sid": "DenyPassRequestAndHighAutonomy",
      "Effect": "Deny",
      "Action": [
        "q:PassRequest",
        "q:GenerateCodeFromCommands",
        "q:UsePlugin",
        "q:CreatePlugin",
        "q:DeletePlugin",
        "q:UpdatePlugin",
        "q:GetPlugin",
        "q:ListPlugins",
        "q:ListPluginProviders",
        "q:CreateOAuthAppConnection",
        "q:UpdateOAuthAppConnection",
        "q:CreateAuthGrant",
        "q:UpdateAuthGrant",
        "q:SentEvent",
        "qdeveloper:StartAgentSession",
        "qdeveloper:TransformCode",
        "qdeveloper:ExportArtifact",
        "qdeveloper:ImportArtifact",
        "qdeveloper:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyAllAdminAndCustomization",
      "Effect": "Deny",
      "Action": [
        "q:CreateAssignment",
        "q:DeleteAssignment",
        "q:UpdateProfile",
        "q:CreateProfile",
        "q:DeleteProfile",
        "codewhisperer:CreateCustomization",
        "codewhisperer:UpdateCustomization",
        "codewhisperer:DeleteCustomization",
        "codewhisperer:UpdateProfile"
      ],
      "Resource": "*"
    }
  ]
}
