{
  "Version": "2012-10-17",
  "_comment": "Org SCP guardrails for Amazon Q Developer. Region-lock all Q APIs, deny high-autonomy features outside approved exception paths, and require MFA for admin mutation.",
  "Statement": [
    {
      "Sid": "RestrictQToApprovedRegions",
      "Effect": "Deny",
      "Action": [
        "q:*",
        "codewhisperer:*",
        "qdeveloper:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "us-east-1",
            "us-west-2"
          ]
        }
      }
    },
    {
      "Sid": "DenyHighAutonomyQFeaturesOrgWide",
      "Effect": "Deny",
      "Action": [
        "q:PassRequest",
        "q:GenerateCodeFromCommands",
        "q:CreatePlugin",
        "q:DeletePlugin",
        "q:UpdatePlugin",
        "q:CreateOAuthAppConnection",
        "q:UpdateOAuthAppConnection",
        "qdeveloper:StartAgentSession",
        "qdeveloper:TransformCode"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalTag/q-autonomy-exception": "approved"
        }
      }
    },
    {
      "Sid": "DenyQCustomizationsOutsideApprovedOrg",
      "Effect": "Deny",
      "Action": [
        "codewhisperer:CreateCustomization",
        "codewhisperer:UpdateCustomization",
        "codewhisperer:DeleteCustomization"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalOrgID": "o-YOUR_ORG_ID"
        }
      }
    },
    {
      "Sid": "RequireMFAForQAdmin",
      "Effect": "Deny",
      "Action": [
        "q:CreateAssignment",
        "q:DeleteAssignment",
        "q:CreateProfile",
        "q:DeleteProfile",
        "q:UpdateProfile",
        "q:CreatePlugin",
        "q:DeletePlugin",
        "q:UpdatePlugin",
        "q:CreateOAuthAppConnection",
        "q:UpdateOAuthAppConnection"
      ],
      "Resource": "*",
      "Condition": {
        "BoolIfExists": {
          "aws:MultiFactorAuthPresent": "false"
        }
      }
    }
  ]
}
